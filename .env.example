# Copy this file to .env.local inside the official Honcho repo.
# Do not put real production secrets in this example file.

AUTH_USE_AUTH=false

# Ollama-compatible OpenAI API endpoint reachable from Honcho Docker containers.
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_API_KEY=ollama

# Local model choices. Adjust to match the models you have pulled in Ollama.
LLM_MODEL=qwen3.5:27b
EMBEDDING_MODEL=qwen3-embedding:4b

# Example local development settings.
ENVIRONMENT=local
LOG_LEVEL=info
